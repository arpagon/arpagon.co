---
// Decorative background. Hidden from assistive tech.
---
<div class="skywrap" aria-hidden="true">
  <canvas id="sky"></canvas>
  <div class="tw"></div>
</div>

<script>
  import { sky, FINAL } from '../scripts/sky.js';
  const c = document.getElementById('sky') as HTMLCanvasElement | null;
  if (c) sky(c, FINAL);
  const tw = document.querySelector('.tw');
  if (tw) for (let i = 0; i < 28; i++) {
    const s = document.createElement('i');
    s.style.left = Math.random() * 100 + '%';
    s.style.top = Math.random() * 70 + '%';
    s.style.animationDelay = Math.random() * 6 + 's';
    tw.appendChild(s);
  }
</script>

<style is:global>
  .skywrap { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  #sky { position: absolute; inset: 0; width: 100%; height: 100%;
    -webkit-mask-image: linear-gradient(90deg, #000 0%, #000a 42%, #0002 70%, #0000);
            mask-image: linear-gradient(90deg, #000 0%, #000a 42%, #0002 70%, #0000); }
  .tw { position: absolute; inset: 0; }
  .tw i { position: absolute; width: 2px; height: 2px; border-radius: 50%; background: #fff; opacity: 0; animation: tw 6s ease-in-out infinite; }
  @keyframes tw { 0%, 100% { opacity: 0; } 50% { opacity: .7; box-shadow: 0 0 6px #fff; } }
  @media (prefers-reduced-motion: reduce) { .tw i { animation: none; opacity: .4; } }
  @media (max-width: 900px) {
    #sky { -webkit-mask-image: linear-gradient(#000 0%, #0008 45%, #0000 80%); mask-image: linear-gradient(#000 0%, #0008 45%, #0000 80%); }
  }
</style>
