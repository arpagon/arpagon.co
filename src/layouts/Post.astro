---
import Base from './Base.astro';
import { profile, type Locale } from '../data/profile';
type Link = { title: string; url: string };
interface Props {
  title: string; description?: string; lang: Locale; date?: Date; markdown?: string;
  originalUrl?: string; series?: Link; cover?: string;
  translations?: { lang: Locale; href: string }[];
  previous?: Link; next?: Link;
}
const { title, description, lang, date, markdown, originalUrl, series, cover, translations = [], previous, next } = Astro.props;
const labels = {
  en: { original: 'Originally published at', note: 'Historical archive: software, links and advice reflect the publication date.', series: 'In this series', previous: 'Earlier', next: 'Later' },
  es: { original: 'Publicado originalmente en', note: 'Archivo histórico: el software, los enlaces y los consejos corresponden a la fecha de publicación.', series: 'En esta serie', previous: 'Anterior', next: 'Siguiente' },
  pt: { original: 'Publicado originalmente em', note: 'Arquivo histórico: software, links e conselhos refletem a data de publicação.', series: 'Nesta série', previous: 'Anterior', next: 'Seguinte' },
}[lang];
const languageNames = { en: 'English', es: 'Español', pt: 'Português' };
---
<Base lang={lang} title={title} description={description} type="article" markdown={markdown} translations={translations} published={date} originalUrl={originalUrl}>
  <div class="post">
    <p class="crumbs mono"><a href="/">arpagon.co</a> / <a href="/writing/">writing</a></p>
    <article>
      <h1>{title}</h1>
      {date && <p class="meta"><time datetime={date.toISOString()}>{date.toISOString().slice(0, 10)}</time> · {profile.name} · {lang.toUpperCase()}{markdown && <> · <a href={markdown}>Markdown</a></>}</p>}
      {originalUrl && <aside class="origin">
        <p>{labels.original} <a href={originalUrl}>{series?.title ?? new URL(originalUrl).hostname} ↗</a>.</p>
        <p>{labels.note}</p>
        {series && <p><a href={series.url}>{labels.series}: {series.title} →</a></p>}
      </aside>}
      {translations.length > 1 && <nav class="translations" aria-label="Translations">{translations.map((translation) => <a href={translation.href} lang={translation.lang} hreflang={translation.lang} aria-current={translation.lang === lang ? 'page' : undefined}>{languageNames[translation.lang]}</a>)}</nav>}
      {cover && <img class="cover" src={cover} alt="" decoding="async" />}
      <div class="prose"><slot /></div>
      {(previous || next) && <nav class="post-nav" aria-label={labels.series}>
        <div>{previous && <a href={previous.url}><small>← {labels.previous}</small>{previous.title}</a>}</div>
        <div>{next && <a href={next.url}><small>{labels.next} →</small>{next.title}</a>}</div>
      </nav>}
    </article>
  </div>
</Base>
<style is:global>
  .post { max-width: 720px; margin: 0 auto; padding: 56px 22px 120px; }
  .post .crumbs { font-size: 13px; color: var(--muted); } .post .crumbs a { color: var(--muted); text-decoration: none; }
  .post h1 { color: var(--fg); font-size: 40px; line-height: 1.15; letter-spacing: -1px; margin: 32px 0 8px; }
  .post .meta { color: var(--muted); font-size: 14px; margin: 0 0 32px; }
  .post .meta a { color: var(--muted); }
  .post h1 { overflow-wrap: anywhere; }
  .post .cover { display: block; width: 100%; height: auto; border-radius: 8px; margin-bottom: 32px; }
  .post .origin { border-left: 2px solid var(--gold); padding: 12px 16px; margin-bottom: 32px; background: #c9a24a09; color: var(--muted); font-size: 14px; }
  .post .origin p { margin: 4px 0; }
  .post .origin a, .post .translations a { color: var(--cream); }
  .post .translations { display: flex; gap: 16px; margin-bottom: 24px; font-size: 14px; }
  .post .translations [aria-current] { color: var(--gold); text-decoration: none; }
  .post .post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; border-top: 1px solid var(--line); padding-top: 24px; margin-top: 48px; }
  .post .post-nav a { display: grid; gap: 8px; font-size: 14px; text-decoration: none; }
  .post .post-nav small { color: var(--muted); }
  @media (max-width: 600px) { .post h1 { font-size: 30px; } .post .post-nav { grid-template-columns: 1fr; } }
  .prose { color: #c4c4c9; font-size: 17px; line-height: 1.75; }
  .prose h1, .prose h2, .prose h3 { color: var(--fg); line-height: 1.25; margin: 2em 0 .6em; }
  .prose h1 { font-size: 28px; } .prose h2 { font-size: 22px; } .prose h3 { font-size: 18px; }
  .prose img { max-width: 100%; height: auto; background: #fff; border-radius: 6px; }
  .prose video { display: block; width: 100%; height: auto; border-radius: 6px; background: #111; }
  .prose figure { margin: 24px 0; }
  .prose table { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; font-size: 14px; margin: 24px 0; }
  .prose th, .prose td { border: 1px solid var(--line); padding: 8px 12px; }
  .prose p, .prose li { overflow-wrap: anywhere; }
  .prose a { color: var(--cream); }
  .prose code { font: .9em var(--mono); background: #16161a; padding: .1em .35em; border-radius: 4px; }
  .prose pre { background: #111114 !important; border: 1px solid #222; padding: 16px; border-radius: 8px; overflow: auto; }
  .prose pre code { background: none; padding: 0; }
  .prose blockquote { border-left: 2px solid var(--gold); margin: 0; padding-left: 16px; color: var(--text); }
</style>
