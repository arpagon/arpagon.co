---
// /cal — booking page. Inline Cal.com embed of https://cal.com/arpagon; the embed script loads only on this page.
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/demos.css';
import Base from '../layouts/Base.astro';

const CAL_LINK = 'arpagon';
const CAL_URL = `https://cal.com/${CAL_LINK}`;
---
<Base lang="en" title="Book a call" description="Book a call with Sebastián Rojo. Pick a time on the calendar.">
  <div class="dm">
    <header class="dm-top mono"><a href="/">arpagon.co</a> / cal</header>
    <main id="main" class="dm-main">
      <section class="dm-hero">
        <p class="dm-kicker mono">❯ cal</p>
        <h1>Let's <em>talk.</em></h1>
        <p class="dm-lede">Pick a time that works for you. · Elige un horario. · Escolha um horário.</p>
      </section>
      <section class="cal" aria-label="Booking calendar">
        <div id="cal-inline" data-cal-link={CAL_LINK}></div>
        <p class="fallback mono"><a href={CAL_URL} rel="noopener">Open the calendar on cal.com ↗</a></p>
      </section>
    </main>
    <footer class="dm-foot mono"><a href="/">← arpagon.co</a></footer>
  </div>
</Base>

<script is:inline>
  // Cal.com embed loader (https://cal.com/embed), unmodified apart from formatting.
  (function (C, A, L) {
    let p = function (a, ar) { a.q.push(ar); };
    let d = C.document;
    C.Cal = C.Cal || function () {
      let cal = C.Cal; let ar = arguments;
      if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement('script')).src = A; cal.loaded = true; }
      if (ar[0] === L) {
        const api = function () { p(api, arguments); };
        const namespace = ar[1];
        api.q = api.q || [];
        if (typeof namespace === 'string') { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ['initNamespace', namespace]); } else p(cal, ar);
        return;
      }
      p(cal, ar);
    };
  })(window, 'https://app.cal.com/embed/embed.js', 'init');

  (function () {
    const el = document.getElementById('cal-inline');
    Cal('init', 'booking', { origin: 'https://app.cal.com' });
    Cal.ns.booking('inline', { elementOrSelector: '#cal-inline', calLink: el.dataset.calLink, config: { layout: 'month_view', theme: 'dark' } });
    // Site palette: --gold as the brand colour on the dark theme.
    Cal.ns.booking('ui', { theme: 'dark', hideEventTypeDetails: false, layout: 'month_view', cssVarsPerTheme: { dark: { 'cal-brand': '#c9a24a' } } });
  })();
</script>

<style>
  .cal { max-width: 1040px; margin: 0 auto; }
  #cal-inline { width: 100%; min-height: 560px; overflow: auto; }
  .fallback { margin: 20px 0 0; text-align: center; font-size: 13px; }
  .fallback a { color: var(--cream); text-decoration: none; }
  .fallback a:hover { color: var(--gold); }
</style>
