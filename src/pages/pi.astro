---
// /pi — Pi coding agent extensions. Layout inspired by https://pi.dev (sticky terminal + scrolling sections).
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import Base from '../layouts/Base.astro';
import { extensions, contributions, STATS_DATE } from '../data/pi';

const installs = (npm: string, repo: string) => [
  { label: 'npm', cmd: `pi install npm:${npm}` },
  { label: 'git', cmd: `pi install git:${repo.replace('https://', '')}` },
  { label: 'try', cmd: `pi -e npm:${npm}` },
];
---
<Base lang="en" title="Pi extensions" description="Extensions for the Pi coding agent by Sebastián Rojo: pi-rewind, pi-animations, pi-context-zone, pi-worktree-tui-status and minimal web providers.">
  <main class="pi">
    <header class="top mono">
      <a href="/">arpagon.co</a> / pi
      <span class="right"><a href="https://pi.dev">pi.dev ↗</a></span>
    </header>

    <section class="hero">
      <p class="kicker mono">❯ pi extensions</p>
      <h1>Pi is a harness you make <em>yours</em>.<br />These are the pieces I made.</h1>
      <p class="lede">
        <a href="https://pi.dev">Pi</a> is a minimal agent harness you adapt with extensions. I build the ones I need to work with agents every day:
        undo, a sense of context health, worktree awareness, web access, and a spinner with taste.
      </p>
      <p class="stats mono">{extensions.length} packages on npm · pi-rewind ★ 116 · ~1.7K downloads/month ({STATS_DATE})</p>
    </section>

    <div class="scrolly">
      <div class="stage" role="region" aria-label="Extension preview">
        <div class="win">
          <div class="bar mono"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span id="wtitle">{extensions[0].name}</span></div>
          {extensions.map((x, i) => (
            <div class={`scr ${i === 0 ? 'on' : ''}`} data-scr={x.id}>
              {x.screen.kind === 'video' ? (
                <video muted loop playsinline controls preload="none" poster={x.screen.poster} aria-label={x.screen.alt}>
                  <source src={x.screen.webm} type="video/webm" /><source src={x.screen.mp4} type="video/mp4" />
                </video>
              ) : (
                <pre class="mono" set:html={x.screen.lines.join('\n')} />
              )}
              <p class="cap mono">{x.screen.caption}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="steps">
        {extensions.map((x) => (
          <article class="step" id={x.id} data-step={x.id}>
            <p class="name mono">{x.name}</p>
            <h2>{x.tagline}</h2>
            <p>{x.desc}</p>
            <ul>{x.features.map((f) => <li>{f}</li>)}</ul>
            <div class="inline">
              {x.screen.kind === 'video' ? (
                <video muted loop playsinline controls preload="none" poster={x.screen.poster} aria-label={x.screen.alt}>
                  <source src={x.screen.webm} type="video/webm" /><source src={x.screen.mp4} type="video/mp4" />
                </video>
              ) : (
                <pre class="mono" set:html={x.screen.lines.join('\n')} />
              )}
              <p class="cap mono">{x.screen.caption}</p>
            </div>
            <div class="tabs" data-tabs>
              <div class="tablist mono" role="tablist" aria-label={`Install ${x.name}`}>
                {installs(x.npm, x.repo).map((t, i) => (
                  <button id={`${x.id}-install-${t.label}`} role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} aria-controls={`${x.id}-command`} data-cmd={t.cmd}>{t.label}</button>
                ))}
              </div>
              <div class="cmd mono" role="tabpanel" id={`${x.id}-command`} aria-labelledby={`${x.id}-install-npm`}><code>$ {installs(x.npm, x.repo)[0].cmd}</code><button type="button" class="copy" aria-label={`Copy install command for ${x.name}`}>[ copy ]</button></div>
              <span class="sr-only" role="status" data-copy-status></span>
            </div>
            <p class="links mono">
              <a href={x.repo}>GitHub ↗</a><a href={`https://www.npmjs.com/package/${x.npm}`}>npm ↗</a>{x.site && <a href={x.site}>site ↗</a>}
            </p>
          </article>
        ))}
      </div>
    </div>

    <section class="contrib">
      <h2>Upstream contributions</h2>
      {contributions.map((c) => (
        <p class="row"><a href={c.url}>{c.title}</a><span class="mono">{c.repo} · {c.state}</span></p>
      ))}
    </section>

    <footer class="mono"><a href="/">← arpagon.co</a> · Pi is by <a href="https://pi.dev">Earendil</a>; this page borrows its idea of a terminal that follows you.</footer>
  </main>
</Base>

<script>
  // Sticky terminal follows the section in view.
  const scrs = [...document.querySelectorAll<HTMLElement>('[data-scr]')];
  const title = document.getElementById('wtitle')!;
  const motion = matchMedia('(prefers-reduced-motion: reduce)');
  const desktop = matchMedia('(min-width: 901px)');
  let active = scrs[0].dataset.scr!;
  const show = (id: string) => {
    active = id;
    for (const s of scrs) {
      const on = s.dataset.scr === id;
      s.classList.toggle('on', on);
      const v = s.querySelector('video');
      if (v) on && desktop.matches && !motion.matches && !document.hidden ? v.play().catch(() => {}) : v.pause();
    }
    title.textContent = id;
  };
  const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && show((e.target as HTMLElement).dataset.step!)), { rootMargin: '-45% 0px -50% 0px' });
  document.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => io.observe(s));
  motion.addEventListener('change', () => show(active));
  desktop.addEventListener('change', () => {
    document.querySelectorAll<HTMLVideoElement>('.inline video').forEach((v) => v.pause());
    show(active);
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) document.querySelectorAll<HTMLVideoElement>('video').forEach((v) => v.pause());
    else show(active);
  });

  // Install tabs + copy.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((box) => {
    const code = box.querySelector('code')!;
    const copy = box.querySelector<HTMLButtonElement>('.copy')!;
    const panel = box.querySelector<HTMLElement>('[role=tabpanel]')!;
    const status = box.querySelector<HTMLElement>('[data-copy-status]')!;
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const select = (button: HTMLButtonElement) => {
      tabs.forEach((tab) => {
        tab.setAttribute('aria-selected', String(tab === button));
        tab.tabIndex = tab === button ? 0 : -1;
      });
      panel.setAttribute('aria-labelledby', button.id);
      code.textContent = `$ ${button.dataset.cmd}`;
      status.textContent = '';
    };
    tabs.forEach((button, index) => {
      button.addEventListener('click', () => select(button));
      button.addEventListener('keydown', (event) => {
        const targets: Record<string, number> = { ArrowRight: (index + 1) % tabs.length, ArrowLeft: (index + tabs.length - 1) % tabs.length, Home: 0, End: tabs.length - 1 };
        const target = targets[event.key];
        if (target === undefined) return;
        event.preventDefault();
        select(tabs[target]);
        tabs[target].focus();
      });
    });
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(code.textContent!.replace(/^\$ /, ''));
        copy.textContent = '[ copied ]';
        status.textContent = 'Command copied.';
      } catch {
        copy.textContent = '[ select ]';
        status.textContent = 'Clipboard unavailable. Select and copy the command manually.';
        const range = document.createRange();
        range.selectNodeContents(code);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
      setTimeout(() => (copy.textContent = '[ copy ]'), 1400);
    });
  });
</script>

<style>
  .pi { --serif: 'Instrument Serif', Georgia, serif; min-height: 100vh;
    background-image: linear-gradient(#ffffff06 1px, transparent 1px), linear-gradient(90deg, #ffffff06 1px, transparent 1px); background-size: 24px 24px; }
  .top { max-width: 1180px; margin: 0 auto; padding: 28px 32px; font-size: 13px; color: var(--muted); display: flex; gap: 6px; }
  .top a { color: var(--muted); text-decoration: none; } .top .right { margin-left: auto; }
  .hero { max-width: 860px; margin: 0 auto; padding: 72px 32px 40px; text-align: center; }
  .kicker { color: var(--gold); font-size: 13px; letter-spacing: 1px; }
  h1 { font: 400 clamp(40px, 6vw, 64px)/1.08 var(--serif); font-style: italic; color: var(--fg); margin: 12px 0 20px; letter-spacing: -.5px; }
  h1 em { color: var(--gold); }
  .lede { font-size: 18px; max-width: 640px; margin: 0 auto; }
  .lede a { color: var(--cream); }
  .stats { margin-top: 22px; font-size: 13px; color: var(--muted); }
  .scrolly { max-width: 1180px; margin: 0 auto; padding: 40px 32px 0; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 56px; }
  .stage { position: relative; }
  .steps { min-width: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .win { position: sticky; top: 12vh; border: 1px solid #2a2a30; border-radius: 10px; background: #0e0e11; box-shadow: 0 24px 80px #0008, 0 0 0 1px #c9a24a14; overflow: hidden; }
  .bar { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-bottom: 1px solid #222; font-size: 12px; color: var(--muted); letter-spacing: 1px; text-transform: uppercase; }
  .dots { display: flex; gap: 6px; } .dots i { width: 10px; height: 10px; border-radius: 50%; background: #2a2a30; }
  .dots i:first-child { background: #c9a24a88; }
  .scr { display: none; } .scr.on { display: block; animation: fade .35s ease; }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .scr.on { animation: none; } }
  .scr pre { margin: 0; padding: 22px; min-height: 340px; font-size: 13.5px; line-height: 1.7; color: #c9d1d9; white-space: pre-wrap; }
  .scr video { display: block; width: 100%; background: #000; }
  .scr .cap { margin: 0; padding: 8px 14px; border-top: 1px solid #1c1c20; font-size: 11px; color: var(--muted); }
  .scr :global(.g) { color: var(--gold); } .scr :global(.d) { color: var(--muted); } .scr :global(.h) { color: var(--fg); font-weight: 700; }
  .scr :global(.s) { color: #0b0b0d; background: var(--cream); } .scr :global(.w) { color: #e3b341; } .scr :global(.r) { color: #ff7b72; }
  .step { min-height: 78vh; padding: 8vh 0; scroll-margin-top: 10vh; }
  .step .name { color: var(--gold); font-size: 13px; margin: 0; }
  .step h2 { font: 400 40px/1.1 var(--serif); font-style: italic; color: var(--fg); margin: 6px 0 14px; }
  .step ul { padding-left: 18px; } .step li { margin: 4px 0; }
  .step .inline { display: none; border-radius: 8px; border: 1px solid #2a2a30; margin: 12px 0; background: #0e0e11; overflow: hidden; }
  .step .inline video { display: block; width: 100%; }
  .step .inline pre { margin: 0; padding: 16px; font-size: 12px; line-height: 1.6; color: #c9d1d9; white-space: pre-wrap; overflow-x: auto; }
  .step .inline .cap { margin: 0; padding: 6px 12px; border-top: 1px solid #1c1c20; font-size: 11px; color: var(--muted); }
  .step .inline :global(.g) { color: var(--gold); } .step .inline :global(.d) { color: var(--muted); } .step .inline :global(.h) { color: var(--fg); font-weight: 700; }
  .step .inline :global(.s) { color: #0b0b0d; background: var(--cream); } .step .inline :global(.w) { color: #e3b341; } .step .inline :global(.r) { color: #ff7b72; }
  .tabs { margin-top: 20px; border: 1px solid #2a2a30; border-radius: 8px; background: #0e0e11; }
  .tablist { display: flex; border-bottom: 1px solid #222; }
  .tablist button { font: 12px var(--mono); letter-spacing: 1px; text-transform: uppercase; color: var(--muted); background: none; border: 0; border-right: 1px solid #222; padding: 10px 16px; cursor: pointer; }
  .tablist button[aria-selected='true'] { color: var(--fg); box-shadow: inset 0 -2px 0 var(--gold); }
  .cmd { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 16px; font-size: 14px; color: #ddd; }
  .cmd code { min-width: 0; overflow-x: auto; white-space: nowrap; }
  .copy { font: 12px var(--mono); color: var(--muted); background: none; border: 1px solid #2a2a30; border-radius: 4px; padding: 6px 10px; cursor: pointer; white-space: nowrap; }
  .copy:hover { color: var(--gold); border-color: var(--gold); }
  .links a { margin-right: 18px; color: var(--cream); text-decoration: none; font-size: 13px; }
  .contrib { max-width: 1180px; margin: 0 auto; padding: 40px 32px; }
  .contrib h2 { font: 400 32px var(--serif); font-style: italic; color: var(--fg); }
  .row { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-top: 1px solid var(--line); }
  .row a { min-width: 0; overflow-wrap: anywhere; color: #ddd; text-decoration: none; } .row span { color: var(--muted); font-size: 13px; }
  footer { max-width: 1180px; margin: 0 auto; padding: 40px 32px 80px; font-size: 13px; color: var(--muted); }
  footer a { color: var(--muted); }
  @media (max-width: 900px) {
    .scrolly { grid-template-columns: 1fr; gap: 0; }
    .stage { display: none; }
    .step { min-height: auto; padding: 32px 0; }
    .step .inline { display: block; }
  }
</style>
