---
import { getCollection, render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { archive } from '../../data/profile';
export async function getStaticPaths() {
  const posts = await getCollection('writing', (p) => !p.data.draft);
  return posts.map((p) => ({ params: { id: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const posts = await getCollection('writing', (p) => !p.data.draft);
const series = archive.find((a) => a.id === post.data.series);
const sameSeries = series ? posts.filter((p) => p.data.series === series.id && p.data.lang === post.data.lang).sort((a, b) => +a.data.date - +b.data.date || a.id.localeCompare(b.id)) : [];
const position = sameSeries.findIndex((p) => p.id === post.id);
const link = (p: (typeof posts)[number] | undefined) => p ? { title: p.data.title, url: `/writing/${p.id}/` } : undefined;
const translations = post.data.translationKey ? posts.filter((p) => p.data.translationKey === post.data.translationKey).map((p) => ({ lang: p.data.lang, href: `/writing/${p.id}/` })) : [];
---
<Post title={post.data.title} description={post.data.description} lang={post.data.lang} date={post.data.date} markdown={`/writing/${post.id}.md`} cover={post.data.cover} originalUrl={post.data.originalUrl} series={series ? { title: series.title, url: series.url } : undefined} translations={translations} previous={link(sameSeries[position - 1])} next={link(sameSeries[position + 1])}>
  <Content />
</Post>
